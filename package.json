  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:import-times": "node scripts/import-times.mjs",
    "db:seed": "node scripts/generate-test-database.mjs",
    "db:seed-genetica": "node scripts/seed-genetica-jogadores.mjs",
    "smoke:medico": "node scripts/smoke-medico-energia.mjs",
